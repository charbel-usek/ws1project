<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.mini_project2.controllers.ProductsController" prefWidth="900" prefHeight="600">
    <left>
        <VBox spacing="10">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Product Details" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <TextField fx:id="nameField" promptText="Name" />
            <TextField fx:id="brandField" promptText="Brand" />
            <ComboBox fx:id="categoryBox" promptText="Category" />
            <TextField fx:id="descField" promptText="Description" />
            <TextField fx:id="quantityField" promptText="Quantity" />
            <TextField fx:id="priceField" promptText="Price" />
            <TextField fx:id="stockField" promptText="Stock" />
            <Button text="Choose Image" onAction="#handleChooseImage" maxWidth="Infinity" />

            <HBox spacing="10">
                <Button text="Add" onAction="#handleAdd" />
                <Button text="Update" onAction="#handleUpdate" />
                <Button text="Delete" onAction="#handleDelete" />
                <Button text="Home" onAction="#goHome" />
            </HBox>

            <Label fx:id="errorLabel" textFill="red" />
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label text="Product Image" />
            <ImageView fx:id="imageView" fitHeight="250" fitWidth="250" preserveRatio="true" />
        </VBox>
    </center>

    <right>
        <TableView fx:id="tableView" prefWidth="450">
            <columns>
                <TableColumn fx:id="nameCol" text="Name" prefWidth="120" />
                <TableColumn fx:id="brandCol" text="Brand" prefWidth="100" />
                <TableColumn fx:id="categoryCol" text="Category" prefWidth="100" />
                <TableColumn fx:id="quantityCol" text="Qty" prefWidth="60" />
                <TableColumn fx:id="priceCol" text="Price" prefWidth="80" />
                <TableColumn fx:id="stockCol" text="Stock" prefWidth="80" />
            </columns>
        </TableView>
    </right>
</BorderPane>